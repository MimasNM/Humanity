<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="600.0" prefWidth="900.0"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="org.example.humanity.controllers.ProductsController">
    <top>
        <HBox alignment="CENTER_LEFT" spacing="12.0">
            <padding>
                <Insets bottom="10.0" left="10.0" right="10.0" top="10.0"/>
            </padding>
            <Label text="Товары"/>
            <Button text="Назад" onAction="#onBack"/>
            <!-- Показывается, если роль не admin: доступно только чтение -->
            <Label fx:id="infoLabel" text="Только просмотр"/>
        </HBox>
    </top>

    <center>
        <TableView fx:id="table">
            <columns>
                <TableColumn fx:id="idColumn" text="ID" prefWidth="50"/>
                <TableColumn fx:id="nameColumn" text="Название" prefWidth="180"/>
                <TableColumn fx:id="descriptionColumn" text="Описание" prefWidth="250"/>
                <TableColumn fx:id="skuColumn" text="SKU" prefWidth="120"/>
                <TableColumn fx:id="priceColumn" text="Цена" prefWidth="90"/>
                <TableColumn fx:id="quantityColumn" text="Кол-во" prefWidth="80"/>
                <TableColumn fx:id="categoryColumn" text="Категория" prefWidth="130"/>
            </columns>
        </TableView>
    </center>

    <!-- Форма и кнопки CRUD скрываются целиком, если роль не admin -->
    <bottom>
        <VBox fx:id="formBox" spacing="8.0">
            <padding>
                <Insets bottom="10.0" left="10.0" right="10.0" top="10.0"/>
            </padding>
            <HBox spacing="8.0">
                <TextField fx:id="nameField" promptText="Название" prefWidth="180"/>
                <TextField fx:id="skuField" promptText="SKU" prefWidth="120"/>
                <TextField fx:id="priceField" promptText="Цена" prefWidth="90"/>
                <TextField fx:id="quantityField" promptText="Количество" prefWidth="100"/>
                <TextField fx:id="categoryField" promptText="Категория" prefWidth="130"/>
            </HBox>
            <TextArea fx:id="descriptionField" promptText="Описание" prefRowCount="2"/>
            <HBox spacing="8.0">
                <Button text="Добавить" onAction="#onAdd"/>
                <Button text="Изменить" onAction="#onUpdate"/>
                <Button text="Удалить" onAction="#onDelete"/>
                <Button text="Очистить" onAction="#onClear"/>
            </HBox>
        </VBox>
    </bottom>
</BorderPane>
