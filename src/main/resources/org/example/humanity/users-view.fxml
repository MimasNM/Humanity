<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="620.0" prefWidth="950.0"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="org.example.humanity.controllers.UsersController">
    <top>
        <HBox alignment="CENTER_LEFT" spacing="12.0">
            <padding>
                <Insets bottom="10.0" left="10.0" right="10.0" top="10.0"/>
            </padding>
            <Label text="Пользователи"/>
            <Button text="Назад" onAction="#onBack"/>
        </HBox>
    </top>

    <center>
        <TableView fx:id="table">
            <columns>
                <TableColumn fx:id="idColumn" text="ID" prefWidth="50"/>
                <TableColumn fx:id="usernameColumn" text="Логин" prefWidth="140"/>
                <TableColumn fx:id="emailColumn" text="Email" prefWidth="180"/>
                <TableColumn fx:id="passwordColumn" text="Пароль" prefWidth="120"/>
                <TableColumn fx:id="fullNameColumn" text="ФИО" prefWidth="160"/>
                <TableColumn fx:id="phoneColumn" text="Телефон" prefWidth="130"/>
                <TableColumn fx:id="roleColumn" text="Роль" prefWidth="80"/>
            </columns>
        </TableView>
    </center>

    <bottom>
        <VBox fx:id="formBox" spacing="8.0">
            <padding>
                <Insets bottom="10.0" left="10.0" right="10.0" top="10.0"/>
            </padding>
            <HBox spacing="8.0">
                <TextField fx:id="usernameField" promptText="Логин" prefWidth="140"/>
                <TextField fx:id="emailField" promptText="Email" prefWidth="180"/>
                <PasswordField fx:id="passwordField" promptText="Пароль" prefWidth="120"/>
                <TextField fx:id="fullNameField" promptText="ФИО" prefWidth="160"/>
                <TextField fx:id="phoneField" promptText="Телефон" prefWidth="130"/>
                <ComboBox fx:id="roleField" promptText="Роль" prefWidth="110"/>
            </HBox>
            <HBox spacing="8.0">
                <Button text="Добавить" onAction="#onAdd"/>
                <Button text="Изменить" onAction="#onUpdate"/>
                <Button text="Удалить" onAction="#onDelete"/>
                <Button text="Очистить" onAction="#onClear"/>
            </HBox>
        </VBox>
    </bottom>
</BorderPane>
